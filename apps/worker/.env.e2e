# Loaded on top of .env when CLOUDFLARE_ENV=e2e (see apps/e2e/playwright.config.ts).
# Overrides only the vars that must differ during e2e runs.

# Emails go to the local `emulate` Resend service (started by Playwright's
# webServer) instead of the real API, so e2e never triggers real sends.
# Captured mail: curl localhost:4008/emails -H "Authorization: Bearer re_emulated_key"
RESEND_API_KEY=re_emulated_key
RESEND_BASE_URL=http://localhost:4008

# Route GitHub/Google sign-in to the emulator (see emulate.config.yaml).
# Client IDs come from wrangler.jsonc vars; the secrets must match the seed.
EMULATE_GITHUB_URL=http://localhost:4001
EMULATE_GOOGLE_URL=http://localhost:4002
GITHUB_CLIENT_SECRET=emulate-github-secret
GOOGLE_CLIENT_SECRET=emulate-google-secret
