{
	"name": "@coding-cowboys/scorebrawl-worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./trpc": "./src/trpc/trpc-router.ts",
		"./id-util": "./src/utils/id-util.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"wrangler-typecheck": "wrangler deploy --dry-run",
		"typecheck": "tsgo --noEmit",
		"test": "vitest run",
		"lint": "oxlint .",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply scorebrawl --local --persist-to ../../.db/local",
		"db:clean": "rm -rf ../../.db/local",
		"db:reset": "bun run db:clean && bun run db:migrate",
		"db:seed": "bun run ./scripts/seed.ts",
		"db:seed:remote": "bun run ./scripts/seed.ts --remote",
		"db:migrate:prod": "wrangler d1 migrations apply scorebrawl --remote",
		"db:studio": "DATABASE_URL=file:$(ls ../../.db/local/v3/d1/miniflare-D1DatabaseObject/*.sqlite | head -1) bun run --bun drizzle-kit studio"
	},
	"dependencies": {
		"@better-auth/api-key": "1.7.3",
		"@better-auth/expo": "catalog:",
		"@better-auth/oauth-provider": "1.7.3",
		"@better-auth/passkey": "catalog:",
		"@coding-cowboys/scorebrawl-core": "workspace:*",
		"@coding-cowboys/scorebrawl-util": "workspace:*",
		"@hono/trpc-server": "^0.4.1",
		"@hono/zod-validator": "^0.4.3",
		"@ihs7/ts-elo": "catalog:",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"cloudflare": "^5.2.0",
		"date-fns": "catalog:",
		"drizzle-orm": "1.0.0-rc.5-169397b",
		"hono": "4.10.7",
		"nanoid": "^5.1.6",
		"resend": "^6.9.1",
		"superjson": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.11.1",
		"@cloudflare/workers-types": "catalog:",
		"@ngneat/falso": "^8.0.2",
		"@types/bun": "^1.3.4",
		"@types/node": "catalog:",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"globals": "16.5.0",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
