{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"types": ["@cloudflare/workers-types"],
		"paths": {
			"@/*": ["./src/*"],
			"@/assets/*": ["./assets/*"],
			"@coding-cowboys/scorebrawl-worker/*": ["../worker/src/*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.ts",
		"expo-env.d.ts",
		"../worker/worker-configuration.d.ts"
	],
	"exclude": [
		"../worker/src",
		"node_modules",
		"babel.config.js",
		"metro.config.js",
		"jest.config.js",
		"android",
		"ios"
	]
}
