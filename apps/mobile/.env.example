# Mirrors the web app's auth option env vars (VITE_* -> EXPO_PUBLIC_*).
# These only control which auth options the login screen shows; the
# server decides what actually works. Copy to .env and adjust.
EXPO_PUBLIC_API_URL=https://scorebrawl.localhost:1355
EXPO_PUBLIC_DISABLE_EMAIL_PASSWORD=
EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=