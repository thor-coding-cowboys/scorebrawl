{
	"name": "@coding-cowboys/scorebrawl",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"better-auth:generate": "bunx @better-auth/cli@latest generate --config apps/worker/src/middleware/context.ts --output apps/worker/src/db/schema/auth-schema.ts",
		"build": "turbo run build",
		"predev": "bun db:migrate",
		"dev": "turbo run dev",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "oxlint --fix .",
		"lint:check": "oxlint .",
		"fmt": "oxfmt . *.md",
		"fmt:check": "oxfmt --check . *.md",
		"check": "bun typecheck && bun lint:check && bun fmt:check",
		"prepare": "bun scripts/git-hooks/install.ts",
		"wrangler-typecheck": "turbo run wrangler-typecheck",
		"db:generate": "bun --cwd apps/worker db:generate",
		"db:migrate": "bun --cwd apps/worker db:migrate",
		"db:clean": "bun --cwd apps/worker db:clean",
		"db:reset": "bun --cwd apps/worker db:reset",
		"db:seed": "bun --cwd apps/worker db:seed",
		"db:migrate:prod": "bun --cwd apps/worker db:migrate:prod",
		"db:studio": "bun --cwd apps/worker db:studio",
		"cf-typegen": "bun --cwd apps/worker cf-typegen"
	},
	"dependencies": {
		"wrangler": "catalog:"
	},
	"devDependencies": {
		"@opencode-ai/sdk": "^1.3.1",
		"@typescript/native-preview": "^7.0.0-dev.20260112.1",
		"oxfmt": "0.34.0",
		"oxlint": "^1.49.0",
		"turbo": "^2.8.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.8",
	"catalog": {
		"@better-auth/expo": "1.7.3",
		"@better-auth/passkey": "1.7.3",
		"@cloudflare/workers-types": "^4.20251213.0",
		"@ihs7/ts-elo": "^2.0.0",
		"@tanstack/react-query": "^5.90.12",
		"@trpc/client": "^11.8.0",
		"@trpc/server": "^11.8.0",
		"@trpc/tanstack-react-query": "^11.8.0",
		"@types/node": "^25.0.1",
		"better-auth": "1.7.3",
		"date-fns": "^4.1.0",
		"react-dom": "19.2.3",
		"react": "19.2.3",
		"superjson": "^2.2.6",
		"typescript": "5.8.3",
		"vitest": "~3.2.0",
		"wrangler": "4.124.0"
	},
	"cloudflare": {
		"label": "Scorebrawl",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_image_url": "https://scorebrawl.com/scorebrawl-monochrome.png",
		"publish": true
	},
	"trustedDependencies": [
		"@shopify/react-native-skia"
	]
}
