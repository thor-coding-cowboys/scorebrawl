{
	"name": "@coding-cowboys/scorebrawl",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"better-auth:generate": "bunx @better-auth/cli@latest generate --config apps/worker/src/middleware/context.ts --output apps/worker/src/db/schema/auth-schema.ts",
		"build": "turbo run build",
		"predev": "bun db:migrate",
		"dev": "turbo run dev",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "oxlint .",
		"format": "oxfmt --check . *.md",
		"check": "bun typecheck && bun lint && bun format",
		"oxc": "oxlint --fix . && oxfmt . *.md",
		"wrangler-typecheck": "turbo run wrangler-typecheck",
		"db:generate": "bun --cwd apps/worker db:generate",
		"db:migrate": "bun --cwd apps/worker db:migrate",
		"db:clean": "bun --cwd apps/worker db:clean",
		"db:reset": "bun --cwd apps/worker db:reset",
		"db:seed": "bun --cwd apps/worker db:seed",
		"db:migrate:prod": "bun --cwd apps/worker db:migrate:prod",
		"db:studio": "bun --cwd apps/worker db:studio",
		"cf-typegen": "bun --cwd apps/worker cf-typegen"
	},
	"dependencies": {
		"wrangler": "4.67.0"
	},
	"devDependencies": {
		"@opencode-ai/sdk": "catalog:",
		"@typescript/native-preview": "catalog:",
		"oxfmt": "0.34.0",
		"oxlint": "^1.49.0",
		"turbo": "^2.8.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.8",
	"catalog": {
		"@base-ui/react": "^1.0.0",
		"@better-auth/passkey": "^1.4.8",
		"@cloudflare/vite-plugin": "1.15.3",
		"@cloudflare/vitest-pool-workers": "^0.11.1",
		"@cloudflare/workers-types": "^4.20251213.0",
